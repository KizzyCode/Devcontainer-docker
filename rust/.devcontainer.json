{
    "image": "devcontainer",
    "customizations": {
        "vscode": {
            "extensions": [
                "rust-lang.rust-analyzer",
                "llvm-vs-code-extensions.lldb-dap"
            ]
        }
    },
    "containerEnv": {
        "OPENCODE_CONFIG_DIR": "${containerWorkspaceFolder}/.devcontainer/",
        "NODE_EXTRA_CA_CERTS": "${containerWorkspaceFolder}/.devcontainer/my-selfsigned-cert.pem"
    }
}
