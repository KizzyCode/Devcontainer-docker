{
    "image": "devcontainer",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/bin/python3"
            }
        }
    },
    "containerEnv": {
        "OPENCODE_CONFIG_DIR": "${containerWorkspaceFolder}/.devcontainer/",
        "NODE_EXTRA_CA_CERTS": "${containerWorkspaceFolder}/.devcontainer/my-selfsigned-cert.pem"
    }
}
